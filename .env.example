# Copy this file to ".env" in the same folder and fill in the values.
# Never commit .env or share it.

# Supabase: Project Settings > Data API > Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase: Project Settings > API Keys > service_role (secret). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# OpenAI: platform.openai.com > Settings > API keys
OPENAI_API_KEY=

# Optional, only for the Gemma option in notebook 03 (Hugging Face > Settings > Access Tokens)
HF_TOKEN=
